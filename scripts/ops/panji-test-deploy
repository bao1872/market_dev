#!/usr/bin/env bash
# panji-test-deploy — 盘迹开发部署唯一本地入口（Live Mount）
#
# 权威来源：
#   - rules/80-deployment-data-safety.md（部署与数据安全硬约束）
#   - docs/runbooks/development-deployment.md（操作步骤）
#
# 职责边界（本脚本是"瘦客户端"，不含任何部署实现逻辑）：
#   1. 校验目标 SHA 存在且是 origin/dev 的祖先；
#   2. 运行 scripts/ops/panji-prod-preflight；
#   3. 通过 SSH 调用服务器仓库内的 scripts/deploy/panji-deploy.sh 执行部署。
#
# 唯一运行模式：Live Mount（docker-compose.prod.yml + docker-compose.live.yml）。
#   本脚本不提供模式开关，不提供镜像构建开关。
#
# 强制约束：
#   - 禁止把部署脚本经 stdin / scp 拷到 /tmp 执行；服务器执行的必须是
#     服务器仓库内受版本控制的 scripts/deploy/panji-deploy.sh；
#   - 禁止手工 scp / docker cp / 容器内改码 / 临时业务脚本；
#   - 禁止碰 PostgreSQL / Redis Volume 或既有持久化数据；
#   - dev 是唯一部署来源；不接受非 origin/dev 祖先的 SHA。
#
# 用法:
#   scripts/ops/panji-test-deploy <FULL_SHA>            # 部署指定 dev SHA
#   scripts/ops/panji-test-deploy <FULL_SHA> --dry-run  # 只输出计划不执行
#
# 环境变量:
#   PANJI_TEST_SKIP_PREFLIGHT=1  跳过 preflight（默认不跳过）
#   PANJI_REMOTE_REPO_ROOT       服务器仓库根目录（默认 /root/web_dev）
#
# 退出码：0 成功，1 失败，2 配置/前置错误

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

REMOTE_REPO_ROOT="${PANJI_REMOTE_REPO_ROOT:-/root/web_dev}"
REMOTE_DEPLOY_SCRIPT="${REMOTE_REPO_ROOT}/scripts/deploy/panji-deploy.sh"
LOCAL_DEPLOY_SCRIPT="${REPO_ROOT}/scripts/deploy/panji-deploy.sh"
SSH_WRAPPER="${SCRIPT_DIR}/panji-prod-ssh"

TARGET_SHA=""
DRY_RUN=false
SKIP_PREFLIGHT="${PANJI_TEST_SKIP_PREFLIGHT:-}"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
fail() { log "错误: $*" >&2; exit 1; }
usage() {
    echo "用法: $0 <SHA> [--dry-run]"
    echo "  FULL_SHA 必须是 origin/dev 的祖先"
    echo "环境变量:"
    echo "  PANJI_TEST_SKIP_PREFLIGHT=1  跳过 preflight（默认不跳过）"
    echo "  PANJI_REMOTE_REPO_ROOT       服务器仓库根目录（默认 /root/web_dev）"
    exit 2
}

# ===== 参数解析 =====
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help) usage ;;
        -*) fail "未知选项: $1（本入口不提供模式/构建开关，唯一模式为 Live Mount）" ;;
        *)
            [[ -z "${TARGET_SHA}" ]] || fail "只能指定一个 SHA"
            TARGET_SHA="$1"
            shift ;;
    esac
done
[[ -n "${TARGET_SHA}" ]] || usage

cd "${REPO_ROOT}"

# ===== 只接受完整 SHA =====
[[ "${TARGET_SHA}" =~ ^[0-9a-fA-F]{40}$ ]] || fail "必须提供 40 位完整 SHA"

if ! git cat-file -e "${TARGET_SHA}^{commit}" 2>/dev/null; then
    fail "SHA 不是本地 commit: ${TARGET_SHA}"
fi
TARGET_SHA="$(git rev-parse "${TARGET_SHA}^{commit}")"
[[ "${TARGET_SHA}" =~ ^[0-9a-fA-F]{40}$ ]] || fail "必须解析为 40 位完整 SHA"

# ===== 校验是 origin/dev 的祖先（dev 是唯一部署来源）=====
log "拉取 origin/dev 最新引用（避免 stale）..."
git fetch origin dev --no-tags 2>&1 | sed 's/^/  /' || fail "git fetch origin dev 失败"

if ! git merge-base --is-ancestor "${TARGET_SHA}" origin/dev 2>/dev/null; then
    fail "SHA ${TARGET_SHA} 不是 origin/dev 的祖先。请先 push dev 并确认已上库。"
fi
log "SHA 校验通过（origin/dev 祖先）: ${TARGET_SHA}"

# ===== 服务器端部署脚本必须存在于仓库（本地静态预检）=====
[[ -f "${LOCAL_DEPLOY_SCRIPT}" ]] \
    || fail "仓库缺少服务器端部署实现: scripts/deploy/panji-deploy.sh"
bash -n "${LOCAL_DEPLOY_SCRIPT}" \
    || fail "scripts/deploy/panji-deploy.sh 语法错误，拒绝部署"

# ===== Preflight =====
if [[ "${SKIP_PREFLIGHT}" != "1" && "${SKIP_PREFLIGHT}" != "true" ]]; then
    log "执行 preflight（scripts/ops/panji-prod-preflight）..."
    if ! bash "${SCRIPT_DIR}/panji-prod-preflight"; then
        fail "preflight 未通过，禁止部署。"
    fi
fi

# ===== SSH 调用服务器仓库内的部署脚本 =====
# 远端当前仓库中的受版本控制脚本负责 fetch、校验并 checkout 目标 SHA。
# dry-run 只做计划，不允许为读取脚本而修改远端工作树。
REMOTE_ARGS=("${TARGET_SHA}")
[[ "${DRY_RUN}" == "true" ]] && REMOTE_ARGS+=(--dry-run)

REMOTE_CMD="set -euo pipefail; cd '${REMOTE_REPO_ROOT}'; test -f '${REMOTE_DEPLOY_SCRIPT}' || { echo '服务器缺少 scripts/deploy/panji-deploy.sh' >&2; exit 2; }; bash '${REMOTE_DEPLOY_SCRIPT}' ${REMOTE_ARGS[*]}"

log "通过 panji-prod-ssh 执行部署（dry-run=${DRY_RUN}）..."
log "远端命令: bash ${REMOTE_DEPLOY_SCRIPT} ${REMOTE_ARGS[*]}"

set +e
"${SSH_WRAPPER}" -o BatchMode=yes -o ConnectTimeout=30 "${REMOTE_CMD}"
SSH_RC=$?
set -e

if [[ "${SSH_RC}" -ne 0 ]]; then
    fail "远程部署失败（SSH rc=${SSH_RC}）。服务保持部署前版本，请查看上方阶段/行号定位。"
fi

log "panji-test-deploy 完成：${TARGET_SHA}"
exit 0
