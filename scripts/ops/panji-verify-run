#!/usr/bin/env bash
# Deprecated compatibility adapter. Formal evidence is still produced by panji-verify.
set -euo pipefail
if [ "$#" -lt 1 ]; then
  echo "usage: $0 <FULL_SHA> [env_file]" >&2
  exit 80
fi
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/panji-verify" run --sha "$1" --plan full-closure \
  --env-file "${2:-market.verify.env}"
