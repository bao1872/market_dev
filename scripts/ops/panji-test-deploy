#!/usr/bin/env bash
# panji-test-deploy — 盘迹开发部署唯一本地入口（Live Mount）
#
# 权威来源：
#   - rules/80-deployment-data-safety.md（部署与数据安全硬约束）
#   - docs/runbooks/development-deployment.md（操作步骤）
#
# 职责边界（本脚本是"瘦客户端"，不含任何部署实现逻辑）：
#   1. 校验目标 SHA 存在且是 origin/dev 的祖先；
#   2. 运行 scripts/ops/panji-prod-preflight；
#   3. 通过 SSH 让服务器**先自举到目标 SHA 工作树**，再执行该工作树中的
#      scripts/deploy/panji-deploy.sh。
#
# 为什么需要自举（首次 Live Mount 部署缺陷修复）：
#   服务器仓库可能仍停在旧 SHA。若直接执行服务器**当前**工作树中的
#   panji-deploy.sh，跑的就是旧脚本，无法保证执行目标 SHA 中的新部署实现。
#   因此远端启动顺序固定为：
#     cd REPO → fetch origin dev → 工作树干净校验 → 目标 SHA 属于 origin/dev
#     → 记录原始 HEAD → checkout --detach 目标 SHA
#     → 执行目标工作树中的 scripts/deploy/panji-deploy.sh
#   dry-run 结束或任何失败都经 trap 恢复原始 HEAD；正式部署成功则保持在目标 SHA。
#
# 唯一运行模式：Live Mount（docker-compose.prod.yml + docker-compose.live.yml）。
#   本脚本不提供模式开关，不提供镜像构建开关。
#
# 强制约束：
#   - 禁止把部署脚本经 stdin / scp 拷到 /tmp 执行；服务器执行的必须是
#     服务器仓库内受版本控制的 scripts/deploy/panji-deploy.sh；
#   - 禁止手工 scp / docker cp / 容器内改码 / 临时业务脚本；
#   - 禁止碰 PostgreSQL / Redis Volume 或既有持久化数据；
#   - dev 是唯一部署来源；不接受非 origin/dev 祖先的 SHA。
#
# 用法:
#   scripts/ops/panji-test-deploy <FULL_SHA>            # 部署指定 dev SHA
#   scripts/ops/panji-test-deploy <FULL_SHA> --dry-run  # 只输出计划不执行
#
# 环境变量:
#   PANJI_TEST_SKIP_PREFLIGHT=1  跳过 preflight（默认不跳过）
#   PANJI_REMOTE_REPO_ROOT       服务器仓库根目录（默认 /root/web_dev）
#
# 退出码：0 成功，1 失败，2 配置/前置错误

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

REMOTE_REPO_ROOT="${PANJI_REMOTE_REPO_ROOT:-/root/web_dev}"
LOCAL_DEPLOY_SCRIPT="${REPO_ROOT}/scripts/deploy/panji-deploy.sh"
SSH_WRAPPER="${SCRIPT_DIR}/panji-prod-ssh"

TARGET_SHA=""
DRY_RUN=false
SKIP_PREFLIGHT="${PANJI_TEST_SKIP_PREFLIGHT:-}"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
fail() { log "错误: $*" >&2; exit 1; }
usage() {
    echo "用法: $0 <SHA> [--dry-run]"
    echo "  FULL_SHA 必须是 origin/dev 的祖先"
    echo "环境变量:"
    echo "  PANJI_TEST_SKIP_PREFLIGHT=1  跳过 preflight（默认不跳过）"
    echo "  PANJI_REMOTE_REPO_ROOT       服务器仓库根目录（默认 /root/web_dev）"
    exit 2
}

# ===== 参数解析 =====
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help) usage ;;
        -*) fail "未知选项: $1（本入口不提供模式/构建开关，唯一模式为 Live Mount）" ;;
        *)
            [[ -z "${TARGET_SHA}" ]] || fail "只能指定一个 SHA"
            TARGET_SHA="$1"
            shift ;;
    esac
done
[[ -n "${TARGET_SHA}" ]] || usage

cd "${REPO_ROOT}"

# ===== 只接受完整 SHA =====
[[ "${TARGET_SHA}" =~ ^[0-9a-fA-F]{40}$ ]] || fail "必须提供 40 位完整 SHA"

if ! git cat-file -e "${TARGET_SHA}^{commit}" 2>/dev/null; then
    fail "SHA 不是本地 commit: ${TARGET_SHA}"
fi
TARGET_SHA="$(git rev-parse "${TARGET_SHA}^{commit}")"
[[ "${TARGET_SHA}" =~ ^[0-9a-fA-F]{40}$ ]] || fail "必须解析为 40 位完整 SHA"

# ===== 校验是 origin/dev 的祖先（dev 是唯一部署来源）=====
log "拉取 origin/dev 最新引用（避免 stale）..."
git fetch origin dev --no-tags 2>&1 | sed 's/^/  /' || fail "git fetch origin dev 失败"

if ! git merge-base --is-ancestor "${TARGET_SHA}" origin/dev 2>/dev/null; then
    fail "SHA ${TARGET_SHA} 不是 origin/dev 的祖先。请先 push dev 并确认已上库。"
fi
log "SHA 校验通过（origin/dev 祖先）: ${TARGET_SHA}"

# ===== 服务器端部署脚本必须存在于仓库（本地静态预检）=====
[[ -f "${LOCAL_DEPLOY_SCRIPT}" ]] \
    || fail "仓库缺少服务器端部署实现: scripts/deploy/panji-deploy.sh"
bash -n "${LOCAL_DEPLOY_SCRIPT}" \
    || fail "scripts/deploy/panji-deploy.sh 语法错误，拒绝部署"

# ===== Preflight =====
if [[ "${SKIP_PREFLIGHT}" != "1" && "${SKIP_PREFLIGHT}" != "true" ]]; then
    log "执行 preflight（scripts/ops/panji-prod-preflight）..."
    if ! bash "${SCRIPT_DIR}/panji-prod-preflight"; then
        fail "preflight 未通过，禁止部署。"
    fi
fi

# ===== SSH 让服务器自举到目标 SHA 后执行目标工作树中的部署脚本 =====
#
# 安全引用：目标 SHA 已通过 40 位十六进制正则校验，DRY_RUN 为脚本内布尔量，
# 二者都不来自未校验输入；仓库路径经 printf %q 转义后嵌入远端脚本。
# 不使用 stdin 传输脚本，不复制到 /tmp，不使用 scp/docker cp，不使用裸 ssh。

Q_REPO_ROOT="$(printf '%q' "${REMOTE_REPO_ROOT}")"
REMOTE_DRY_FLAG=""
[[ "${DRY_RUN}" == "true" ]] && REMOTE_DRY_FLAG=" --dry-run"

read -r -d '' REMOTE_CMD <<REMOTE_SCRIPT || true
set -euo pipefail

TARGET_SHA=${TARGET_SHA}
REPO_ROOT=${Q_REPO_ROOT}
ORIGINAL_REF=""
ORIGINAL_SHA=""
RESTORE_HEAD=true

cd "\${REPO_ROOT}"

# 1. 拉取 origin/dev（不拉 tag）
git fetch origin dev --no-tags

# 2. 工作树必须干净——脏工作树下 checkout 会丢失或阻断
if [[ -n "\$(git status --porcelain)" ]]; then
    echo "服务器工作树不干净，拒绝自举到目标 SHA" >&2
    git status --short >&2
    exit 2
fi

# 3. 目标 SHA 必须存在且属于 origin/dev
if ! git cat-file -e "\${TARGET_SHA}^{commit}" 2>/dev/null; then
    echo "服务器上不存在该 commit: \${TARGET_SHA}" >&2
    exit 2
fi
if ! git merge-base --is-ancestor "\${TARGET_SHA}" origin/dev; then
    echo "SHA \${TARGET_SHA} 不是 origin/dev 的祖先，拒绝自举" >&2
    exit 2
fi

# 4. 记录自举前状态：
#    ORIGINAL_REF  —— 用于 dry-run/失败后恢复（分支名优先，detached 时记录完整 SHA）；
#    ORIGINAL_SHA  —— 自举前 repo 的 40 位完整 SHA，仅作为"上一真实运行 SHA"的
#                     最终 fallback（经 PANJI_BOOTSTRAP_PREVIOUS_SHA 传给部署脚本）。
#    注意：ORIGINAL_SHA 是服务器自举前的 repo HEAD，未必等于当前真实运行镜像；
#    首次 Live Mount 时部署脚本应优先读取当前运行 backend 的 /v1/version，
#    只有全部运行时来源都失效才回退到此值。
if ORIGINAL_REF="\$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    :
else
    ORIGINAL_REF="\$(git rev-parse HEAD)"
fi
ORIGINAL_SHA="\$(git rev-parse HEAD)"
if [[ ! "\${ORIGINAL_SHA}" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "无法解析自举前完整 SHA: \${ORIGINAL_SHA}" >&2
    exit 2
fi
echo "[bootstrap] 原始 REF = \${ORIGINAL_REF}"
echo "[bootstrap] 原始 SHA = \${ORIGINAL_SHA}"

restore_head() {
    local rc=\$?
    if [[ "\${RESTORE_HEAD}" == "true" && -n "\${ORIGINAL_REF}" ]]; then
        echo "[bootstrap] 恢复原始 REF: \${ORIGINAL_REF}"
        git -C "\${REPO_ROOT}" checkout -f "\${ORIGINAL_REF}" >/dev/null 2>&1 \\
            || echo "[bootstrap] WARN: 恢复原始 REF 失败，请手动检查" >&2
    fi
    exit \${rc}
}
trap restore_head EXIT

# 5. 自举到目标 SHA 工作树
echo "[bootstrap] checkout --detach \${TARGET_SHA}"
git checkout -f --detach "\${TARGET_SHA}"

DEPLOY_SCRIPT="\${REPO_ROOT}/scripts/deploy/panji-deploy.sh"
if [[ ! -f "\${DEPLOY_SCRIPT}" ]]; then
    echo "目标 SHA 中缺少 scripts/deploy/panji-deploy.sh" >&2
    exit 2
fi

# 6. 执行**目标工作树**中的部署实现
# 关闭 errexit 以捕获退出码：失败时仍须经 trap 恢复原始 REF。
# PANJI_BOOTSTRAP_PREVIOUS_SHA：自举前的完整 SHA，作为"上一真实运行 SHA"的
# 最终 fallback，经受控环境变量传递（不通过 stdin、不写 /tmp）。
echo "[bootstrap] 执行目标 SHA 工作树中的 panji-deploy.sh"
set +e
PANJI_BOOTSTRAP_PREVIOUS_SHA="\${ORIGINAL_SHA}" \
    bash "\${DEPLOY_SCRIPT}" "\${TARGET_SHA}"${REMOTE_DRY_FLAG}
DEPLOY_RC=\$?
set -e

# 正式部署成功后服务器保持在目标 SHA；dry-run 始终恢复原始 REF
if [[ "\${DEPLOY_RC}" -eq 0 && "${DRY_RUN}" != "true" ]]; then
    RESTORE_HEAD=false
    echo "[bootstrap] 部署成功，服务器保持在目标 SHA"
fi

exit \${DEPLOY_RC}
REMOTE_SCRIPT

log "通过 panji-prod-ssh 执行部署（dry-run=${DRY_RUN}）..."
log "远端序列: fetch → 干净校验 → 祖先校验 → 记录 HEAD → checkout --detach ${TARGET_SHA} → 目标工作树 panji-deploy.sh"

set +e
"${SSH_WRAPPER}" -o BatchMode=yes -o ConnectTimeout=30 "${REMOTE_CMD}"
SSH_RC=$?
set -e

if [[ "${SSH_RC}" -ne 0 ]]; then
    fail "远程部署失败（SSH rc=${SSH_RC}）。服务保持部署前版本，请查看上方阶段/行号定位。"
fi

log "panji-test-deploy 完成：${TARGET_SHA}"
exit 0
