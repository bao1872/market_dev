#!/usr/bin/env bash
# Unique local control entry for formal remote verification.
set -euo pipefail

usage() {
  echo "usage: $0 run --sha <FULL_SHA> [--plan targeted-pg|migration-roundtrip|full-closure] [--ref <verify-branch>]" >&2
  exit 80
}

[ "${1:-}" = "run" ] || usage
shift
SHA=""
VERIFY_REF=""
# Exploration 默认只做 targeted-pg（upgrade_head + pg_contract）。
# full-closure（PG + Seed + E2E）属于 Hardening/Release，必须显式 --plan full-closure。
PLAN="targeted-pg"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --sha) SHA="${2:-}"; shift 2 ;;
    --plan) PLAN="${2:-}"; shift 2 ;;
    --ref) VERIFY_REF="${2:-}"; shift 2 ;;
    --env-file) echo "panji-verify: --env-file is no longer accepted" >&2; exit 80 ;;
    *) usage ;;
  esac
done

echo "$SHA" | grep -Eq '^[0-9a-f]{40}$' || {
  echo "panji-verify: --sha must be a complete 40-character lowercase hex SHA" >&2
  exit 80
}
case "$PLAN" in
  targeted-pg|migration-roundtrip|full-closure) ;;
  *)
    echo "panji-verify: unregistered plan '$PLAN' (allowed: targeted-pg, migration-roundtrip, full-closure)" >&2
    exit 80
    ;;
esac

# VERIFY_REF 校验（与远程 runner 一致）：只允许合法 branch ref，默认空（远程 fallback 到 dev）。
if [[ -n "${VERIFY_REF}" ]]; then
  if ! git check-ref-format --branch "${VERIFY_REF}" >/dev/null 2>&1; then
    echo "panji-verify: --ref 不是合法 branch ref（拒绝：${VERIFY_REF}）" >&2
    exit 80
  fi
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$SCRIPT_DIR/panji-prod-preflight" || exit 10

# [C bootstrap] explicit --ref：先让远程对象库取得 verification branch（窄化 refspec，不 checkout/
# reset/改 worktree），并在本层校验 SHA == 远程 branch tip。首次运行时远程仍是旧 runner（不
# 含 ref membership 校验），故 membership 必须由本 bootstrap 层 fail-closed 保证。
# 默认（无 --ref）不执行任何 bootstrap，dev verification 路径完全不变。
if [[ -n "${VERIFY_REF}" ]]; then
  echo "panji-verify: bootstrap ref=${VERIFY_REF} sha=${SHA} (fetch exact ref + sha==tip membership)"
  BOOTSTRAP_CMD="cd /root/web_dev_verify && git fetch origin refs/heads/${VERIFY_REF}:refs/remotes/origin/${VERIFY_REF} && git cat-file -e ${SHA}^{commit} && [ \"\$(git rev-parse refs/remotes/origin/${VERIFY_REF})\" = \"${SHA}\" ] && echo PANJI_BOOTSTRAP_OK"
  "$SCRIPT_DIR/panji-prod-ssh" "$BOOTSTRAP_CMD" || {
    echo "panji-verify: bootstrap FAILED (fetch 或 sha==branch-tip membership 校验未通过，fail-closed)" >&2
    exit 11
  }
fi

"$SCRIPT_DIR/panji-prod-ssh" \
  "cd /root/web_dev_verify && scripts/verify/run_remote_verification.sh '$SHA' '$PLAN' '${VERIFY_REF:-}'"
