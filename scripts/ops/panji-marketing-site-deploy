#!/usr/bin/env bash
# panji-marketing-site-deploy — Marketing Site 轻部署通道（独立静态 artifact）
#
# 权威来源：M0_ARCHITECTURE_CONTRACT.md §Public Marketing Site Lightweight Lane
#
# 与 scripts/ops/panji-test-deploy（whole-system runner）的严格区分：
#   - 只构建 Marketing Site 小 bundle（vite build marketing-site），不重建整站 SPA；
#   - 只写入：
#       /opt/panji-live/frontend/dist/marketing-assets/   （JS/CSS 资源目录）
#       /opt/panji-live/frontend/dist/portal/index.html   （根门户 HTML）
#   - 旧 /marketing-preview/ 退役为 redirect tombstone（301 行为，未来由 nginx 升级为 HTTP 301）；
#   - 不执行 scripts/deploy/panji-deploy.sh；
#   - 不碰 backend / worker / database / RUNTIME_SHA / market.env / nginx.conf；
#   - 不 restart 任何容器；只靠 Nginx 对 dist 的 live bind mount 立即生效。
#
# 设计要点：
#   - 服务器用独立 git worktree（/opt/panji-marketing-site-src）从目标 SHA 构建，
#     不改 /root/web_dev 当前 production deployment state；
#   - node_modules 走 Docker named volume 缓存，仅当 package-lock 哈希变化才 npm ci；
#   - 部署顺序：先 rsync assets 再 install index（避免短暂引用不存在的新 asset）；
#   - 硬断言：主 SPA index.html 哈希 + trading-frontend 容器 StartedAt 部署前后一致。
#
# 用法:
#   scripts/ops/panji-marketing-site-deploy <FULL_SHA> [--dry-run]
#
# 退出码：0 成功，1 失败，2 配置/前置错误

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
SSH_WRAPPER="${SCRIPT_DIR}/panji-prod-ssh"

# 可调环境变量（默认值对齐生产部署事实）
LIVE_ROOT="${PANJI_LIVE_ROOT:-/opt/panji-live}"
PROD_REPO="${PANJI_PROD_REPO:-/root/web_dev}"
SITE_SRC="${PANJI_SITE_SRC:-/opt/panji-marketing-site-src}"
SITE_CACHE="${PANJI_SITE_CACHE:-/opt/panji-marketing-site-cache}"
NODE_VOLUME="${PANJI_NODE_VOLUME:-panji-marketing-site-node-modules}"
NODE_IMAGE="${PANJI_NODE_IMAGE:-node:20-alpine}"
FRONTEND_CONTAINER="${PANJI_FRONTEND_CONTAINER:-trading-frontend}"

# 部署目标（与 repo nginx.conf `location = /` -> /portal/index.html 一致）
SITE_ASSET_TARGET="${LIVE_ROOT}/frontend/dist/marketing-assets"
CURRENT_ROOT_HTML="${LIVE_ROOT}/frontend/dist/portal/index.html"
LEGACY_PREVIEW_TARGET="${LIVE_ROOT}/frontend/dist/marketing-preview"

TARGET_SHA=""
DRY_RUN=false

log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"; }
fail() { log "错误: $*" >&2; exit 1; }

# ===== 参数解析 =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help) echo "usage: $0 <SHA> [--dry-run]"; exit 2 ;;
    -*) fail "未知选项: $1" ;;
    *)
      [[ -z "${TARGET_SHA}" ]] || fail "只能指定一个 SHA"
      TARGET_SHA="$1"; shift ;;
  esac
done
[[ -n "${TARGET_SHA}" ]] || { echo "usage: $0 <SHA> [--dry-run]" >&2; exit 2; }

cd "${REPO_ROOT}"

# ===== 本地校验：40 位 SHA + 属 origin/dev 祖先 =====
[[ "${TARGET_SHA}" =~ ^[0-9a-fA-F]{40}$ ]] || fail "必须提供 40 位完整 SHA"
git fetch origin dev --no-tags 2>&1 | sed 's/^/  /' || fail "git fetch origin dev 失败"
if ! git merge-base --is-ancestor "${TARGET_SHA}" origin/dev 2>/dev/null; then
  fail "SHA ${TARGET_SHA} 不是 origin/dev 的祖先。请先 push dev 并确认已上库。"
fi
log "SHA 校验通过（origin/dev 祖先）: ${TARGET_SHA}"

# ===== 转义（注入远端命令前）=====
q() { printf '%q' "$1"; }
Q_PROD_REPO="$(q "${PROD_REPO}")"
Q_SITE_SRC="$(q "${SITE_SRC}")"
Q_SITE_ASSET_TARGET="$(q "${SITE_ASSET_TARGET}")"
Q_CURRENT_ROOT_HTML="$(q "${CURRENT_ROOT_HTML}")"
Q_LEGACY_PREVIEW_TARGET="$(q "${LEGACY_PREVIEW_TARGET}")"
Q_SITE_CACHE="$(q "${SITE_CACHE}")"
Q_LIVE_ROOT="$(q "${LIVE_ROOT}")"
Q_NODE_VOLUME="$(q "${NODE_VOLUME}")"
Q_NODE_IMAGE="$(q "${NODE_IMAGE}")"
Q_FRONTEND_CONTAINER="$(q "${FRONTEND_CONTAINER}")"

if [[ "${DRY_RUN}" == "true" ]]; then
  log "[dry-run] 计划：在 ${SITE_SRC} worktree 从 ${TARGET_SHA} 构建 marketing-site，"
  log "[dry-run]       仅 rsync 到 ${SITE_ASSET_TARGET}/ 并 install 到 ${CURRENT_ROOT_HTML}，"
  log "[dry-run]       退役 ${LEGACY_PREVIEW_TARGET}/ 为 redirect tombstone。不改主 SPA / 容器 / nginx。"
  exit 0
fi

# ===== 远端执行（经唯一 SSH wrapper）=====
read -r -d '' REMOTE_CMD <<REMOTE_SCRIPT || true
set -euo pipefail

TARGET_SHA=${TARGET_SHA}
PROD_REPO=${Q_PROD_REPO}
SITE_SRC=${Q_SITE_SRC}
SITE_ASSET_TARGET=${Q_SITE_ASSET_TARGET}
CURRENT_ROOT_HTML=${Q_CURRENT_ROOT_HTML}
LEGACY_PREVIEW_TARGET=${Q_LEGACY_PREVIEW_TARGET}
SITE_CACHE=${Q_SITE_CACHE}
LIVE_ROOT=${Q_LIVE_ROOT}
NODE_VOLUME=${Q_NODE_VOLUME}
NODE_IMAGE=${Q_NODE_IMAGE}
FRONTEND_CONTAINER=${Q_FRONTEND_CONTAINER}

echo "[site] 校验 SHA 属 origin/dev 祖先（服务器侧）"
git -C "\${PROD_REPO}" fetch origin dev --no-tags
if ! git -C "\${PROD_REPO}" merge-base --is-ancestor "\${TARGET_SHA}" origin/dev; then
  echo "SHA 不是 origin/dev 祖先，拒绝自举" >&2
  exit 2
fi

# 1. 独立 site worktree（不改 PROD_REPO 当前工作树）
if [[ -f "\${SITE_SRC}/.git" ]]; then
  echo "[site] worktree 已存在，reset --hard \${TARGET_SHA}"
  git -C "\${SITE_SRC}" reset --hard "\${TARGET_SHA}" >/dev/null
else
  echo "[site] 首次创建 worktree: \${SITE_SRC}"
  git -C "\${PROD_REPO}" worktree add --detach "\${SITE_SRC}" "\${TARGET_SHA}"
fi

BUILD_DIR="\${SITE_SRC}/frontend/dist-marketing-site"

# 2. node_modules 缓存：仅在 volume 缺失或 package-lock 变化时才 npm ci
mkdir -p "\${SITE_CACHE}"
LOCK="\${SITE_SRC}/frontend/package-lock.json"
HASH_NOW="\$(sha256sum "\${LOCK}" | awk '{print \$1}')"
CACHE_FILE="\${SITE_CACHE}/package-lock.sha256"
HASH_CACHED="\$(cat "\${CACHE_FILE}" 2>/dev/null || echo '')"
NEED_CI=0
if ! docker volume inspect "\${NODE_VOLUME}" >/dev/null 2>&1; then
  NEED_CI=1
elif [[ "\${HASH_NOW}" != "\${HASH_CACHED}" ]]; then
  NEED_CI=1
fi

# 3. 清理旧 build 产物（worktree 内未跟踪目录，安全删除）
rm -rf "\${BUILD_DIR}"

BUILD_CMD="npm run build:marketing-site"
if [[ "\${NEED_CI}" -eq 1 ]]; then
  echo "[site] package-lock 变化或缓存缺失，执行 npm ci（node image: \${NODE_IMAGE}）"
  BUILD_CMD="npm ci && npm run build:marketing-site"
  echo "\${HASH_NOW}" > "\${CACHE_FILE}"
else
  echo "[site] node_modules 缓存命中，跳过 npm ci"
fi

echo "[site] 构建 marketing-site bundle（docker run \${NODE_IMAGE}）"
docker run --rm \
  -v "\${SITE_SRC}/frontend:/app" \
  -v "\${NODE_VOLUME}:/app/node_modules" \
  -w /app \
  "\${NODE_IMAGE}" \
  sh -c "\${BUILD_CMD}"

if [[ ! -f "\${BUILD_DIR}/index.html" ]]; then
  echo "site build 产物缺失，构建可能失败" >&2
  exit 1
fi

# 4. 硬安全断言 BEFORE（主 SPA 与容器状态）
MAIN_INDEX_BEFORE="\$(sha256sum "\${LIVE_ROOT}/frontend/dist/index.html" 2>/dev/null | awk '{print \$1}')"
FRONTEND_STARTED_BEFORE="\$(docker inspect "\${FRONTEND_CONTAINER}" --format '{{.State.StartedAt}}' 2>/dev/null || echo N/A)"
echo "[safety] MAIN_INDEX_BEFORE=\${MAIN_INDEX_BEFORE}"
echo "[safety] FRONTEND_STARTED_BEFORE=\${FRONTEND_STARTED_BEFORE}"

# 5. 部署顺序：先 assets 后 media 后 root index（避免短暂引用缺失资源）
mkdir -p "\${SITE_ASSET_TARGET}/assets"
rsync -a --delete "\${BUILD_DIR}/assets/" "\${SITE_ASSET_TARGET}/assets/"
mkdir -p "\${SITE_ASSET_TARGET}/media"
rsync -a --delete "\${BUILD_DIR}/media/" "\${SITE_ASSET_TARGET}/media/"
install -m 0644 "\${BUILD_DIR}/index.html" "\${CURRENT_ROOT_HTML}"

# 6. 退役 /marketing-preview/：删除后重建 redirect tombstone
rm -rf "\${LEGACY_PREVIEW_TARGET}"
mkdir -p "\${LEGACY_PREVIEW_TARGET}"
cat > "\${LEGACY_PREVIEW_TARGET}/index.html" <<'TOMBSTONE'
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="0;url=/">
  <meta name="robots" content="noindex,nofollow">
  <link rel="canonical" href="/">
  <script>location.replace('/')</script>
</head>
<body></body>
</html>
TOMBSTONE

# 7. 旧 /landing/index.html 若存在，降级为相同 tombstone（不变更历史素材）
if [[ -f "\${LIVE_ROOT}/frontend/dist/landing/index.html" ]]; then
  cp "\${LEGACY_PREVIEW_TARGET}/index.html" "\${LIVE_ROOT}/frontend/dist/landing/index.html"
  echo "[site] /landing/index.html -> tombstone"
fi

# 8. 硬安全断言 AFTER
MAIN_INDEX_AFTER="\$(sha256sum "\${LIVE_ROOT}/frontend/dist/index.html" 2>/dev/null | awk '{print \$1}')"
FRONTEND_STARTED_AFTER="\$(docker inspect "\${FRONTEND_CONTAINER}" --format '{{.State.StartedAt}}' 2>/dev/null || echo N/A)"
if [[ "\${MAIN_INDEX_BEFORE}" != "\${MAIN_INDEX_AFTER}" ]]; then
  echo "SAFETY FAIL: 主 SPA index.html 被修改（\${MAIN_INDEX_BEFORE} -> \${MAIN_INDEX_AFTER}）" >&2
  exit 1
fi
if [[ "\${FRONTEND_STARTED_BEFORE}" != "\${FRONTEND_STARTED_AFTER}" ]]; then
  echo "SAFETY FAIL: frontend 容器被 restart（\${FRONTEND_STARTED_BEFORE} -> \${FRONTEND_STARTED_AFTER}）" >&2
  exit 1
fi
echo "[safety] 主 SPA 未改 + 容器未重启：断言通过"

# 9. 验证
echo "=== verify ==="
ROOT_HTML="\$(curl -s http://127.0.0.1/)"
HTTP_ROOT="\$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1/)"
echo "root / HTTP: \${HTTP_ROOT}"
echo "root title: \$(echo "\${ROOT_HTML}" | grep -o '<title>[^<]*</title>')"

if echo "\${ROOT_HTML}" | grep -q '/marketing-preview/'; then
  echo "VERIFY FAIL: 根 HTML 仍含 /marketing-preview/" >&2
  exit 1
fi
if ! echo "\${ROOT_HTML}" | grep -q '/marketing-assets/'; then
  echo "VERIFY FAIL: 根 HTML 缺少 /marketing-assets/" >&2
  exit 1
fi

ASSET="\$(echo "\${ROOT_HTML}" | grep -oE '/marketing-assets/assets/[^"]*\\.js' | head -1)"
if [[ -z "\${ASSET}" ]]; then
  echo "VERIFY FAIL: 根 HTML 未引用 marketing-assets JS" >&2
  exit 1
fi
HTTP_ASSET="\$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1\${ASSET}")"
echo "asset \${ASSET} HTTP: \${HTTP_ASSET}"

HTTP_MARKET="\$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1/market)"
echo "/market HTTP: \${HTTP_MARKET}"

# /marketing-assets/media/* 必须 200（V1.1 真实图片部署修复：飞书 poster + 两张 workspace）
for f in poster_img1.webp intraday-monitor.webp market-workspace.webp; do
  MEDIA_HTTP="\$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1/marketing-assets/media/\${f}")"
  echo "/marketing-assets/media/\${f} HTTP: \${MEDIA_HTTP}"
  if [[ "\${MEDIA_HTTP}" != "200" ]]; then
    echo "VERIFY FAIL: /marketing-assets/media/\${f} 非 200" >&2
    exit 1
  fi
done

# 旧 /marketing-preview/ 不得再返回 Marketing Site HTML
PREVIEW_HTML="\$(curl -s http://127.0.0.1/marketing-preview/)"
if echo "\${PREVIEW_HTML}" | grep -q 'MarketingPage\|marketing-assets'; then
  echo "VERIFY FAIL: /marketing-preview 仍承载 Marketing Site" >&2
  exit 1
fi
echo "/marketing-preview/ 已降级为 tombstone: \$(echo "\${PREVIEW_HTML}" | grep -o 'location.replace' | head -1)"

# 旧 /landing/index.html 不得再显示旧门户
if [[ -f "\${LIVE_ROOT}/frontend/dist/landing/index.html" ]]; then
  LANDING_HTML="\$(curl -s http://127.0.0.1/landing/index.html)"
  if echo "\${LANDING_HTML}" | grep -q 'MarketingPage\|marketing-assets'; then
    echo "VERIFY FAIL: /landing 仍承载门户" >&2
    exit 1
  fi
  echo "/landing/index.html 已降级为 tombstone"
fi

if [[ "\${HTTP_ROOT}" != "200" || "\${HTTP_ASSET}" != "200" || "\${HTTP_MARKET}" != "200" ]]; then
  echo "VERIFY FAIL: 状态检查未通过" >&2
  exit 1
fi
echo "[site] 部署完成：\${CURRENT_ROOT_HTML}"
REMOTE_SCRIPT

log "通过 panji-prod-ssh 执行轻部署（SHA ${TARGET_SHA}）..."
set +e
"${SSH_WRAPPER}" -o BatchMode=yes -o ConnectTimeout=30 "${REMOTE_CMD}"
SSH_RC=$?
set -e

if [[ "${SSH_RC}" -ne 0 ]]; then
  fail "远端轻部署失败（SSH rc=${SSH_RC}）。生产主 SPA / 容器未被改动（脚本在断言失败前即退出）。"
fi

log "panji-marketing-site-deploy 完成：${TARGET_SHA}"
exit 0
