#!/usr/bin/env bash
# panji-board-sync — 本地手动同步问财板块/概念快照到生产库
#
# [BOARD-LOCAL-OWNERSHIP-01]
# 归属迁移：板块/概念同步的**网络 owner 是本地 Mac**（本地 cookie 访问问财），
# 生产服务器只接收已构造好的规范化快照，并继续由唯一 DB 写 owner
# `board_sync_service.sync_boards()` 做门禁 + 原子写库。
#
# 用法：
#   scripts/ops/panji-board-sync             # 抓取 → SSH stdin → 生产原子应用
#   scripts/ops/panji-board-sync --dry-run   # 仅本地抓取 + 构造/校验 envelope，不 SSH、不写库
#
# 语义约定：
#   - 无日期参数、无频率参数、无 force 绕过校验。
#   - **不限制频率**：同一天可重复同步；相同快照可安全重放（不是每天一次/冷却）。
#   - 并发保护：生产 importer 用事务级 advisory lock 做 single-flight；这**不是**频率限制。
#   - cookie 只在本地使用；**绝不**通过 SSH/命令行/env 传到服务器。
#   - 传输走 **stdin**（不把大 JSON 作为 shell 参数，也不用 base64 命令替换）。
#
# 退出码：0=成功；非零=失败（本地抓取失败 / SSH 失败 / 生产校验或门禁失败）。
# 失败时生产库保留上一成功快照（importer 整体 rollback）。

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/ops/panji-board-sync [--dry-run]

  (no args)   本地抓取问财板块快照 → SSH stdin → 生产 importer 原子应用并打印结果
  --dry-run   仅本地抓取并构造/校验 envelope，打印摘要；不 SSH、不改动生产
EOF
}

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "panji-board-sync: 未知参数 '$arg'" >&2; usage; exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PY="$ROOT/backend/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "panji-board-sync: 缺少 backend/.venv/bin/python（请先创建后端虚拟环境）" >&2
  exit 3
fi

PRODUCER_SHA="$(cd "$ROOT" && git rev-parse HEAD 2>/dev/null || echo unknown)"

TMP_ENV="$(mktemp -t panji-board-envelope.XXXXXX)"
cleanup() { rm -f "$TMP_ENV"; }
trap cleanup EXIT

cd "$ROOT/backend"

if [ "$DRY_RUN" = "1" ]; then
  echo "panji-board-sync: [dry-run] 本地抓取问财板块快照（本地 cookie）..."
  "$PY" -m app.cli.board_snapshot_export --dry-run --producer-git-sha "$PRODUCER_SHA"
  echo "panji-board-sync: [dry-run] 完成（未 SSH、未改动生产）"
  exit 0
fi

echo "panji-board-sync: 本地抓取问财板块快照（本地 cookie，不发送 cookie 到服务器）..."
"$PY" -m app.cli.board_snapshot_export --out "$TMP_ENV" --producer-git-sha "$PRODUCER_SHA"

echo "panji-board-sync: 通过 SSH stdin 发送快照到生产 importer（不发送 cookie）..."
REMOTE_CMD='cd /root/web_dev && docker compose --env-file /etc/market-dev/market.env -f docker-compose.prod.yml -f docker-compose.live.yml run --rm -T backend python -m app.cli.board_snapshot_import'

set +e
# shellcheck disable=SC2002
cat "$TMP_ENV" | "$SCRIPT_DIR/panji-prod-ssh" "$REMOTE_CMD"
RC=$?
set -e

if [ "$RC" -ne 0 ]; then
  echo "panji-board-sync: 生产应用失败（exit=$RC）；生产库保留上一成功快照" >&2
  exit "$RC"
fi

echo "panji-board-sync: 完成（下一次正常盘后 rebuilding_market_dashboard 会消费最新成分）"
