# market.verify.env.example — V2.1 验证栈环境模板（DS-111）
# 复制为 market.verify.env 并填充；DATABASE_URL 必须指向 bz_stock_verify_<sha>。
# 严禁填写 bz_stock；REDIS 用独立 DB（/1）隔离。

# 必须与待验收 origin/dev 精确 commit 一致（用于运行时 SHA 校验）
# [CP3] 运行时 SHA 来自 Live Mount 的 /root/web_dev_verify/RUNTIME_SHA（由部署脚本按 HEAD 生成），
#       不再依赖镜像 tag；GIT_SHA 仅作记录用途。
GIT_SHA=REPLACE_WITH_VERIFY_SHA

# 验证库（DS-110）：bz_stock_verify_<sha>
# [CP3] 部署脚本解析本 URL 的 database 段与 bz_stock_verify_<sha> 做**全等**比较，
#       并在应用连上后执行 SELECT current_database() 二次确认。
# 格式：postgresql+psycopg://bz:<password>@trading-postgres:5432/bz_stock_verify_<sha>
DATABASE_URL=postgresql+psycopg://bz:CHANGE_ME@trading-postgres:5432/bz_stock_verify_REPLACE_WITH_SHA

# 独立验证 Redis（方案 B：verify-redis 容器，隔离更清楚，不暴露宿主机端口）
REDIS_URL=redis://verify-redis:6379/0

JWT_SECRET=CHANGE_ME_VERIFY_ONLY
FRONTEND_BASE_URL=http://verify-frontend

# 验证环境标识（fail-closed：conftest/部署脚本检查 APP_ENV=verification）
APP_ENV=verification

# 自动 Scheduler 关闭（DS-111）
PANJI_SCHEDULER_ENABLED=false

# 复用正式 config（只读挂载）
# [CP3] Live Mount 下 /app/app 是只读父挂载，config 必须挂到 /app/config.production.py
#       （与 docker-compose.live.yml 既有约定一致，见 CHANGE-20260724-004）
CONFIG_FILE=/app/config.production.py

# [CP3] 以下三项由部署脚本自动探测并注入，通常无需在此设置：
#   VERIFY_CODE_DIR       固定 /root/web_dev_verify
#   VERIFY_PG_NETWORK     实测 trading-postgres 所在 Docker 网络名
#   VERIFY_BACKEND_IMAGE / VERIFY_FRONTEND_IMAGE  复用正式镜像作为依赖底座

# 资源预算（可选覆盖，默认保守）
PANJI_BACKEND_MEM_LIMIT=1024m
PANJI_POSTGRES_MEM_LIMIT=1536m
