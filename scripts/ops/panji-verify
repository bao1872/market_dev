#!/usr/bin/env bash
# Unique local control entry for formal remote verification.
set -euo pipefail

usage() {
  echo "usage: $0 run --sha <FULL_SHA> [--plan full-closure] [--env-file FILE]" >&2
  exit 80
}

[ "${1:-}" = "run" ] || usage
shift
SHA=""
PLAN="full-closure"
ENV_FILE="market.verify.env"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --sha) SHA="${2:-}"; shift 2 ;;
    --plan) PLAN="${2:-}"; shift 2 ;;
    --env-file) ENV_FILE="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done

echo "$SHA" | grep -Eq '^[0-9a-f]{40}$' || {
  echo "panji-verify: --sha must be a complete 40-character lowercase hex SHA" >&2
  exit 80
}
[ "$PLAN" = "full-closure" ] || {
  echo "panji-verify: unregistered plan '$PLAN'" >&2
  exit 80
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$SCRIPT_DIR/panji-prod-preflight" || exit 10

REMOTE_PLAN="scripts/verify/plans/${PLAN}.json"
"$SCRIPT_DIR/panji-prod-ssh" "cd /root/web_dev_verify && python scripts/verify/verify_attempt.py \
  --target-sha '$SHA' \
  --verify-db-url \"\${VERIFY_DB_URL:?VERIFY_DB_URL must be provided by the remote verification environment}\" \
  --compose-project 'panji-verify-${SHA}' \
  --env-file '$ENV_FILE' \
  --compose-file docker-compose.verify.yml \
  --plan '$REMOTE_PLAN'"
